# Rendering toolchain (installed by skills/sei-diagrams/scripts/setup.sh).
# package-lock.json IS committed: it pins the renderer so every clone renders identically.
skills/sei-diagrams/node_modules/

# Artifacts produced by running the skills in a target project
/architecture/

# Personal Claude Code settings (model pin, local permissions) — not shared,
# so cloning this repo never overrides a contributor's own model choice
.claude/settings.local.json

# Rendered output kept next to sources in examples is fine to commit;
# ad-hoc renders are not
*.log

# OS / editor
.DS_Store
.idea/
*.swp
__pycache__/
*.pyc
