  "themeCSS": ".node rect, .node polygon, .node circle, .node path { stroke-width: 1.5px; } g.source > rect, g.source > polygon, .source > rect { fill: #E7E3F3 !important; stroke: #6B5BA6 !important; } g.artifact > rect, .artifact > rect { fill: #EDF2F8 !important; stroke: #3E6DA5 !important; } g.response > rect, .response > rect { fill: #E4F0E9 !important; stroke: #3F7D5C !important; } g.internal > rect, .internal > rect { fill: #EDF2F8 !important; stroke: #3E6DA5 !important; } g.external > rect, .external > rect { fill: #F5EEE3 !important; stroke: #B07D3B !important; } g.datastore > rect, .datastore > rect { fill: #E4F0E9 !important; stroke: #3F7D5C !important; } g.emphasis > rect, .emphasis > rect { fill: #F6E4E4 !important; stroke: #B04A46 !important; } .cluster rect { fill: #FBFCFE !important; stroke: #9AA7B4 !important; stroke-dasharray: 4 3 !important; } .edgeLabel { color: #1F2933; background-color: #FFFFFF; } .flowchart-link { stroke: #6B7A8D; }",
  "flowchart": {
    "curve": "basis",
    "nodeSpacing": 55,
    "rankSpacing": 70,
    "padding": 12,
    "useMaxWidth": true,
    "htmlLabels": true
  },
  "sequence": {
    "diagramMarginX": 40,
    "diagramMarginY": 24,
    "boxMargin": 12,
    "mirrorActors": false,
    "bottomMarginAdj": 4,
    "useMaxWidth": true,
    "rightAngles": false,
    "showSequenceNumbers": false
  },
  "c4": {
    "diagramMarginX": 40,
    "diagramMarginY": 30,
    "c4ShapeMargin": 40,
    "c4ShapePadding": 18,
    "width": 220,
    "height": 90,
    "useMaxWidth": true
  },
  "class": {
    "useMaxWidth": true
  }
}
