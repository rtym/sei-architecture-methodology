flowchart LR
  %% Quality attribute scenario — SQA-1 — Security / confidentiality
  src["<b>Source of stimulus</b><br/>Authenticated user (attacker)"]
  stim["<b>Stimulus</b><br/>Requests another user's<br/>transactions by guessing IDs"]
  subgraph env["Environment: Normal operation"]
    art["<b>Artifact</b><br/>API layer + data store"]
  end
  resp["<b>Response</b><br/>Request rejected;<br/>attempt logged and alerted"]
  meas["<b>Response measure</b><br/>0 successful cross-user reads;<br/>100% logged; alert &lt; 1 min"]
  src -->|generates| stim --> art
  art --> resp -->|measured by| meas
  classDef source   fill:#E7E3F3,stroke:#6B5BA6,color:#1F2933;
  classDef artifact fill:#EDF2F8,stroke:#3E6DA5,color:#1F2933;
  classDef response fill:#E4F0E9,stroke:#3F7D5C,color:#1F2933;
  class src,stim source
  class art artifact
  class resp,meas response
