@startuml scenario-MQA-1
!include ../../../../../skills/sei-diagrams/assets/plantuml-theme.puml
left to right direction
hide stereotype
title Quality attribute scenario — MQA-1 — Maintainability / modifiability
rectangle "<b>Source of stimulus</b>\nDeveloper" as SRC #E7E3F3
rectangle "<b>Stimulus</b>\nAdds a new dashboard report type" as STIM #E7E3F3
rectangle "<b>Artifact</b>\nReporting module and read model" as ART #EDF2F8
rectangle "<b>Response</b>\nChange is isolated to the reporting module and its tests; no other module is touched" as RESP #E4F0E9
rectangle "<b>Response measure</b>\n<= 1 person-day; <= 3 modules touched; 0 regressions" as MEAS #E4F0E9
rectangle "<b>Environment</b>\nDuring a sprint" as ENV #F5EEE3
SRC  --> STIM : generates
STIM --> ART  : arrives at
ART  --> RESP : produces
RESP --> MEAS : measured by
ENV  ..> ART
@enduml
