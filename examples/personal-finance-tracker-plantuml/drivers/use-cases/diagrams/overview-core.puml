@startuml overview-core
!include plantuml-theme.puml
skinparam actorStyle awesome
left to right direction
title Use case overview — Personal Finance Tracker (core)
actor "Registered user" as user
rectangle "Bank Import API" <<system>> as bank
rectangle "Personal Finance Tracker" {
  usecase "UC-1\nRecord a transaction" as uc1
  usecase "UC-2\nView the monthly dashboard" as uc2
  usecase "UC-3\nImport a bank statement" as uc3
  usecase "UC-4\nCategorise transaction" as uc4
}
user --> uc1
user --> uc2
user --> uc3
bank --> uc3
uc1 ..> uc4 : <<include>>
uc3 ..> uc4 : <<include>>
@enduml
