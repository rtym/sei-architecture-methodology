@startuml scenario-PQA-2
!include plantuml-theme.puml
left to right direction
hide stereotype
title Quality attribute scenario — PQA-2 — Performance efficiency / capacity
rectangle "<b>Source of stimulus</b>\nRegistered user" as SRC #E7E3F3
rectangle "<b>Stimulus</b>\nImports a 5 000-row CSV bank statement" as STIM #E7E3F3
rectangle "<b>Artifact</b>\nImport Worker" as ART #EDF2F8
rectangle "<b>Response</b>\nParses, maps and bulk-inserts asynchronously; interactive traffic is unaffected" as RESP #E4F0E9
rectangle "<b>Response measure</b>\nImport completes < 30 s; dashboard p95 stays < 1.8 s during the import" as MEAS #E4F0E9
rectangle "<b>Environment</b>\nNormal operation" as ENV #F5EEE3
SRC  --> STIM : generates
STIM --> ART  : arrives at
ART  --> RESP : produces
RESP --> MEAS : measured by
ENV  ..> ART
@enduml
